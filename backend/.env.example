# ==========================================
# DATABASE (Supabase PostgreSQL)
# Нууц үгэнд ? @ $ & : / байвал URL-encode хий (жишээ: ? -> %3F)
# ==========================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ==========================================
# SUPABASE
# ==========================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=violation-snapshots
SIGNED_URL_EXPIRE_SECONDS=3600

# ==========================================
# SECRETS (хуваалцахгүй, git-д оруулахгүй)
# Үүсгэх:
#   CAMERA_SECRET_KEY : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   JWT_SECRET / INTERNAL_API_KEY : python -c "import secrets; print(secrets.token_urlsafe(48))"
# CAMERA_SECRET_KEY ба INTERNAL_API_KEY нь ai-service/.env-тэй ИЖИЛ байх ёстой.
# ==========================================
CAMERA_SECRET_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
INTERNAL_API_KEY=CHANGE_ME
JWT_EXPIRE_MINUTES=480

# ==========================================
# API
# ==========================================
CORS_ORIGINS=http://localhost:3000
# HTTPS дээр заавал true
COOKIE_SECURE=false
LOG_LEVEL=INFO
LOG_DIR=./logs

# Browser-ийн холбогдох MediaMTX WebRTC хаяг (production дээр https домэйн)
MEDIAMTX_PUBLIC_URL=http://localhost:8889
STREAM_TOKEN_EXPIRE_SECONDS=120

# ==========================================
# WEBRTC ICE (browser ↔ MediaMTX NAT traversal). Дэлгэрэнгүй: infra/README.md
# ==========================================
# STUN (таслалаар). Хоосон = STUN-гүй
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# TURN (таслалаар), шаардлагатай бол. Хоосон = TURN-гүй
#   жишээ: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
TURN_URLS=
# coturn use-auth-secret горим: static-auth-secret-тэй ИЖИЛ утга (хугацаатай credential үүсгэнэ)
TURN_SECRET=
# TURN_SECRET байхгүй бол үйлчилгээний статик credential
TURN_USERNAME=
TURN_PASSWORD=
TURN_CREDENTIAL_TTL_SECONDS=86400

# Snapshot зураг + зөрчлийг энэ хугацаа (минут) өнгөрмөгц автоматаар устгана. 0 = хэзээ ч устгахгүй. 10080 = 7 хоног
SNAPSHOT_RETENTION_MINUTES=10080

# ==========================================
# ALERT (DB, AI service, камер, edge tunnel унтарвал/сэргэвэл). Дэлгэрэнгүй: SECURITY.md
# НУУЦ: URL нь token агуулна. Хоосон = alert унтраалттай.
#   Discord : https://discord.com/api/webhooks/<ID>/<TOKEN>
#   Slack   : https://hooks.slack.com/services/<...>
#   Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
# ==========================================
ALERT_WEBHOOK_URL=
ALERT_CHECK_SECONDS=60
