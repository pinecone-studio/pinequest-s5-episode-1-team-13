# Frontend-д зөвхөн public config орно. Нууц утга (camera password,
# Supabase service key, DB password) энд ХЭЗЭЭ Ч орохгүй.

# /api/* хүсэлтийг Next.js энэ backend руу дамжуулна (next.config.ts rewrites) — cookie first-party болно (Safari).
# Локал: worker.py нь backend-ийг 8001 дээр асаана. Production (Vercel): Railway backend-ийн хаяг.
BACKEND_URL=http://localhost:8001
# WebSocket шууд backend руу (Vercel proxy WebSocket дэмждэггүй); нэвтрэлт нь /api/auth/ws-token-оос авсан токен.
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws
# Сонголттой: proxy-гүйгээр шууд backend руу хандах бол (cookie 3rd-party болж Safari-д ажиллахгүй)
# NEXT_PUBLIC_API_URL=http://localhost:8001
