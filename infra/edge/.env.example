# ==========================================
# EDGE (docker compose -f infra/edge/<factory|factory-quick|vps|ai>.yml)
# Энэ файлыг infra/edge/.env болгон хуулж бөглөнө. .env-ийг ХЭЗЭЭ Ч commit хийхгүй.
# ==========================================

# --- Бүх горим ---
# Backend-ийн нийтийн хаяг (Railway). localhost БИШ: container дотор localhost = container өөрөө.
# Төгсгөлд "/" бичихгүй (MediaMTX-ийн нэвтрэлтийн хаяг <BACKEND_URL>/internal/mediamtx/auth болно).
BACKEND_URL=https://YOUR-BACKEND.up.railway.app
# backend/.env-ийн INTERNAL_API_KEY-тэй ИЖИЛ (ai-service/.env-ийнхийг дарна)
INTERNAL_API_KEY=CHANGE_ME

# --- factory.yml, factory-quick.yml, vps.yml ---
# Browser-ийн видео (ICE) холбогдох энэ машины хаяг(ууд), таслалаар.
#   factory*.yml: үйлдвэрийн компьютерийн LAN IP (жишээ 192.168.1.50). Router дээр 8189 udp/tcp-г port-forward хийсэн бол public IP-г нэмнэ.
#   vps.yml:      VPS-ийн public IP
EDGE_HOSTS=192.168.1.50

# --- factory.yml, factory-quick.yml, ai.yml ---
# training/models/ доторх моделийн файлын нэр (вэбийн Training хуудсаар сургасан .onnx эсвэл .pt)
MODEL_FILE=ppe.pt

# --- factory.yml, vps.yml ---
# MediaMTX-ийн тогтмол HTTPS домэйн (https://, "/" бичихгүй).
#   factory.yml: Cloudflare tunnel-ийн Public Hostname (infra/README.md "Тогтмол домэйн")
#   vps.yml:     DNS A record нь VPS-ийн IP руу заасан домэйн
MEDIA_DOMAIN=media.example.com

# --- factory.yml ---
# Cloudflare Zero Trust -> Networks -> Tunnels -> tunnel -> token ("cloudflared ... run --token" командын сүүлийн утга). НУУЦ.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# --- ai.yml (VPS горим, үйлдвэрийн компьютер) ---
# VPS-ийн MediaMTX RTSPS хаяг: rtsps://<MEDIA_DOMAIN>:8322
MEDIAMTX_RTSP_URL=rtsps://media.example.com:8322
