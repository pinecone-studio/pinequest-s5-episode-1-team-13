# ==========================================
# AI SERVICE
# Copy this file to .env and fill in the values.
# INTERNAL_API_KEY must be the SAME as backend/.env
# ==========================================

# Backend (FastAPI) address
BACKEND_URL=http://localhost:8001
INTERNAL_API_KEY=TnNkMRbXRgJ61plIL3BKA9vSvpGtNcjQ73D1Z6d7zTg

# How often the AI tells the backend "I'm alive" (seconds). Backend marks AI OFFLINE after 30s.
HEARTBEAT_SECONDS=10

LOG_LEVEL=INFO

# ==========================================
# DATABASE + SECRETS (same values as backend/.env)
# ==========================================
DATABASEDATABASE_URL=postgresql://postgres.qgeyqwnbsshmbxtkrgig:DB%3FpXpY%243bkgd4%26@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
CAMERA_SECRET_KEY=P46mdpoUqwysIO-TKoVKRhkkbk_B6sO4Rs--SHCj5LQ=

# ==========================================
# VIDEO (MediaMTX)
# ==========================================
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
# IP cameras and webcams: AI sends the video to MediaMTX so the dashboard can play it. Needs ffmpeg installed.
PUBLISH_VIDEO=true
PUBLISH_FPS=15
CAMERA_REFRESH_SECONDS=10
# One stats line per camera in the log this often (seconds). 0 = off
STATS_SECONDS=60

# ==========================================
# AI MODEL (YOLO)
# ==========================================
# .pt or .onnx. Relative to the ai-service folder. After training on the web "Training" page:
#   MODEL_PATH=../training/models/<trained-model>.onnx  and leave CLASS_MAPPING empty
MODEL_PATH=../training/models/ppe.pt
# Only for models with other class names, e.g. a public hard-hat model:
#   CLASS_MAPPING=person:person,hardhat:helmet,no-hardhat:no_helmet,safety vest:work_uniform,no-safety vest:no_work_uniform
CLASS_MAPPING=
CONF_THRESHOLD=0.4
# "NO helmet" / "NO uniform" boxes must be surer than this to count (fewer false alarms)
NO_CONF_THRESHOLD=0.55
# Helmet/uniform state per person = majority of the last N AI results, so boxes don't flicker (1 = off)
SMOOTH_WINDOW=5
IMGSZ=640
DETECT_FPS=3
# auto = fastest available: NVIDIA GPU (cuda) > Apple GPU (mps, .pt models only) > cpu
DEVICE=auto
# Skip the model when nothing moves and nobody is in the picture (saves CPU). Still checks every MOTION_MAX_SKIP_SECONDS.
MOTION_SKIP=true
MOTION_THRESHOLD=0.01
MOTION_MAX_SKIP_SECONDS=5

# ==========================================
# VIOLATIONS
# ==========================================
# A violation is saved only after it is seen for this many seconds (filters out one-frame mistakes)
VIOLATION_CONFIRM_SECONDS=2
# The same person with the same violation is saved again only after this many seconds
VIOLATION_COOLDOWN_SECONDS=60
# Frames darker or blurrier than this are not used for violations or training pictures (0 = turn the check off)
# Brightness 0..255. Sharpness: sharp pictures are in the hundreds, strong blur is under ~20.
MIN_BRIGHTNESS=35
MIN_SHARPNESS=25

# Supabase Storage for snapshot pictures (same values as backend/.env)
SUPABASE_URL=https://qgeyqwnbsshmbxtkrgig.supabase.co/
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFnZXlxd25ic3NobWJ4dGtyZ2lnIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTQ0Njk2OCwiZXhwIjoyMTA3MDIyOTY4fQ.tmFitkrQ8FG8Re8Sk2EZcE1WirPBZupbbs9mMkeGZOE
SUPABASE_STORAGE_BUCKET=violation-snapshots

# ==========================================
# TRAINING DATA
# ==========================================
# When "collection" is ON in the web Training page, frames + AI guesses are saved here for labelling.
# Must be the same folder as backend TRAINING_DIR.
DATASET_DIR=../training
